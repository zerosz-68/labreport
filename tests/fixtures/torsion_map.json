{
  "_说明": "填写映射示例：table/row/col 是**屏幕上看到的**物理网格坐标（1 起）；find 是文字锚点定位。此处人名/学号均为占位符。",
  "data": "torsion.json",
  "targets": [
    { "table": 2, "row": 1, "col": 2, "set": "{{experiment}}" },
    { "table": 2, "row": 2, "col": 2, "set": "XX 班" },
    { "table": 2, "row": 2, "col": 5, "set": "2025000000" },
    { "table": 2, "row": 2, "col": 7, "set": "张三" },
    { "table": 2, "row": 3, "col": 2, "set": "2025000001" },
    { "table": 2, "row": 3, "col": 6, "set": "李四" },

    { "find": "实验报告应包括以下内容", "append": "（本行由 labreport fill 追加）" },

    { "table": 2, "row": 5, "col": 1, "append": "一、实验目的：理解刚体转动惯量的测量原理与平行轴定理。" },
    { "table": 2, "row": 6, "col": 1, "append": "五、实验数据记录" },
    { "table": 2, "row": 6, "col": 1, "append": "圆柱理论转动惯量：" },
    {
      "table": 2, "row": 6, "col": 1, "append": true,
      "formula": "J_{1\\mathrm{理}}=\\frac{1}{8}mD^{2}={{targets.J1理}}"
    },
    {
      "table": 2, "row": 6, "col": 1, "append": true,
      "formula": "J_{2\\mathrm{实}}=\\frac{K(T_{2}^{2}-T_{0}^{2})}{4\\pi^{2}}={{targets.J2实}}"
    }
  ]
}
